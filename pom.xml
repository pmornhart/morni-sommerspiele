<?xml version="1.0" encoding="UTF-8"?>
<!-- Morni-Sommerspiele: Spielmodus „Sommerspiele“ des MoinMorni-Netzwerks (Paper-Plugin). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.moinmorni</groupId>
  <artifactId>morni-sommerspiele</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Morni-Sommerspiele</name>

  <properties>
    <!-- Paper 26.x läuft nur mit Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Gleicher Code = gleiche Jar (feste Zeitstempel): das Netzwerk startet den Server nur bei echten Änderungen neu. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <paper.version>26.3.build.249-stable</paper.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Prüfung, ob der Code auch gegen die ältere Paper-API 26.1.2 übersetzt (Test-Server mit mineflayer). -->
    <profile>
      <id>paper-26.1</id>
      <properties>
        <paper.version>26.1.2.build.74-stable</paper.version>
      </properties>
    </profile>
  </profiles>

  <build>
    <finalName>Morni-Sommerspiele</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <!-- Die Netzwerk-Schnittstelle (src/api/java) wird nur mitübersetzt: zur Laufzeit kommt sie vom Netzwerk-Plugin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
                <compileSourceRoot>${project.basedir}/src/api/java</compileSourceRoot>
              </compileSourceRoots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <excludes>
            <exclude>de/moinmorni/api/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
</project>
